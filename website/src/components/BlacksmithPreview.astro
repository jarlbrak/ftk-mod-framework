---
import preview from '../data/blacksmith-preview.json';
const base=import.meta.env.BASE_URL;
---
<p class="preview-status">Coming Soon</p>
<p class="preview-note">{preview.artwork}</p>
<div class="blacksmith-gallery">
{preview.items.map(item=><article class:list={['forge-card',item.rarity.toLowerCase()]} aria-label={item.name}>
 <div class="forge-art"><img src={`${base}media/blacksmith/${item.id}.webp`} alt={`Studio render of ${item.name}`} width="512" height="512" loading="lazy" /></div>
 <header class="forge-identity"><img src={`${base}media/blacksmith/${item.id}.webp`} alt={`Thumbnail of ${item.name}`} width="30" height="36" loading="lazy"/><h2>{item.name}</h2><p class="forge-rarity">{item.rarity}</p></header>
 <div class="forge-properties">{item.damage&&<p class="forge-damage"><strong>{item.damage}</strong> {item.damageType}</p>}{item.lines.map(line=><p class={line.tone}>{line.text}</p>)}</div>
 {['tl','tr','bl','br'].map(position=><span class={`forge-corner ${position}`} aria-hidden="true"/>)}
</article>)}
</div>
<style>
.preview-status{display:inline-block;margin:0!important;padding:6px 13px;border:1px solid #b69656;border-radius:4px;color:#efcc86;font-size:14px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.preview-note{font-size:13px;color:var(--sl-color-gray-2)}.blacksmith-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:24px;align-items:start}.forge-card{--rim:#9363a3;--bar:#40234d;--base:#180d23;position:relative;margin:0!important;border:2px solid var(--rim);background:var(--base);color:#eeeae1;font-family:"Arial Narrow","Avenir Next Condensed",Arial,sans-serif;box-shadow:0 8px 24px #0003;overflow:hidden}.forge-card.common{--rim:#776957;--bar:#30291f;--base:#211c16}.forge-card *{box-sizing:border-box;margin:0}.forge-art{height:263px;display:grid;place-items:center;overflow:hidden;border-bottom:3px double var(--rim);background:radial-gradient(ellipse,#ffffff08,transparent 75%)}.forge-art img{display:block;width:100%;height:263px;object-fit:contain;padding:12px 0}.forge-identity{position:relative;min-height:49px;padding:3px 5px 3px 43px;background:var(--bar);border-bottom:2px solid var(--rim)}.forge-identity img{position:absolute;left:7px;top:5px;width:30px;height:36px;object-fit:contain}.forge-identity h2{color:#eeeae1;font:600 23px/25px "Arial Narrow","Avenir Next Condensed",Arial,sans-serif;letter-spacing:-.35px;margin:0!important;text-shadow:1px 1px 2px #000;overflow-wrap:normal}.forge-rarity{font:700 16px/17px Arial,sans-serif;color:#c080f1}.common .forge-rarity{color:#eee1cb}.forge-properties{min-height:126px;padding:5px 6px 16px;font:italic 14px/18px Arial,sans-serif;letter-spacing:-.25px}.forge-properties p{margin:0!important}.forge-properties .affinity{color:#79a2d6}.forge-properties .ability{color:#ffdf9a}.forge-properties .skill{color:#c4b6a6}.forge-properties .forge-damage{font-style:normal;border-bottom:1px solid var(--rim);padding:3px 0 7px;margin-bottom:7px!important}.forge-damage strong{font-size:27px;margin-right:9px}.forge-corner{position:absolute;width:8px;height:8px;border:1px solid var(--rim);background:var(--base);pointer-events:none}.forge-corner:after{content:"";position:absolute;inset:2px 0 0 2px;border-top:1px solid var(--rim);border-left:1px solid var(--rim);width:3px;height:3px}.tl{top:1px;left:1px}.tr{top:1px;right:1px;transform:rotate(90deg)}.bl{bottom:1px;left:1px;transform:rotate(-90deg)}.br{bottom:1px;right:1px;transform:rotate(180deg)}
</style>
