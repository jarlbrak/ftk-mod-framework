# Build output
bin/
obj/
*.user

# Rider / VS
.idea/
.vs/

# macOS
.DS_Store

# Local decompile dumps / scratch
/decomp/
/scratch/

# Superpowers process artifacts (specs/brainstorm output) — keep local, not committed
docs/superpowers/

# Do NOT commit game assemblies (copyright). Reference them from the install instead.
# This also ignores the BUILT sample-behaviour DLL (it is a build artifact: rebuild it via
# `dotnet build FTKModFramework/Samples/SampleBehaviorMod/SampleBehavior.csproj -c Release`).
*.dll
!**/lib/**/*.dll
# Exception: the BehaviorLoader broken-DLL test fixture is a tiny committed text file (NOT a real
# assembly), used to prove Assembly.LoadFrom failure is isolated. It must be tracked.
!FTKModFramework/SampleData/com.ftkmf.brokendll/broken.dll

# Pre-existing local file, not part of the framework
backend.log

# Local image-generation scratch output (e.g. nanobanana). Committed assets live under FTKModFramework/assets/.
nanobanana-output/

# Local model-campaign media. Canonical manifests and authored runtime assets
# are committed explicitly; bulk captures and Blender work files stay outside
# ordinary Git history.
art-experiments/**/*.blend
art-experiments/**/*.blend1
art-experiments/**/*.mp4
art-experiments/**/*.png
art-experiments/**/*.gz
art-experiments/**/*.jsonl
art-experiments/**/*.log
art-experiments/**/*.zip
docs/evidence/**/*.mp4
docs/evidence/**/*.png
docs/evidence/**/*.gz
docs/evidence/**/*.jsonl

# Python bytecode cache (agent-harness MCP server)
__pycache__/
*.pyc

# Agent tooling. Public instructions and adapters are committed; machine-specific
# paths, services, settings, worktrees, and memory stay local.
AGENTS.local.md
AGENTS.override.md
CLAUDE.local.md
.local/
.codex/config.local.toml
.claude/settings.local.json
.claude/settings.json
.claude/hookify.*.local.md
.claude/hooks/
.claude/hooks/local/
.claude/plans/
.claude/agents/knowledge-curator.md
.claude/worktrees/
.claude/scheduled_tasks.lock

# Release scratch (release.sh builds assets in a temp dir, but never commit a dist/)
dist/
