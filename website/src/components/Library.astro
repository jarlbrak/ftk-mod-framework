---
import catalog from '../data/catalog.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section class="library-hero" aria-labelledby="_top">
 <div><span class="eyebrow">Community made · For The King (2018)</span><h1 id="_top" data-page-title>Another oath.<br/>A new adventure.</h1><p class="lead">Make your next journey through Fahrul your own. Discover original classes, distinctive equipment, and a familiar world seen a little differently.</p><div class="actions"><a class="button primary" href={`${base}/installation/`}>Start playing ↗</a><a class="button" href="#mod-library">Explore the mods ↓</a></div><p class="meta">Framework 1.2.0 · Original game required</p></div>
 <figure class="hero-image"><img src={`${base}/media/kingsfall-poster.webp`} alt="Kingsfall, the published Paladin legendary great hammer, rendered in studio lighting" width="1280" height="800" fetchpriority="high"/><figcaption>KINGSFALL / Paladin 1.3.0 · Original model, studio render</figcaption></figure>
</section>
<div class="section-line"><h2 id="mod-library">The mod library</h2><span class="eyebrow">3 published packages · Curated catalog</span></div>
<div class="mod-grid">{catalog.packages.map(p=><article class="mod-card"><img src={`${base}/media/${p.name.toLowerCase()}.webp`} alt={p.name==='Paladin'?'Paladin Censure armor in the game inventory':p.name==='Thief'?'Illustrated promotional artwork for the Thief class':'Promotional artwork for the Possum appearance'} width="640" height="400" loading="lazy"/><div class="body"><span class="pill">{p.name==='Thief'?'Published playtest':'Published'} · {p.version}</span><h3>{p.name}</h3><p>{p.description}</p><p class="meta">{p.category==='classes'?'CLASS':'APPEARANCE'} · Framework {p.frameworkVersion}+ within 1.x</p><a href={`${base}/mods/${p.name.toLowerCase()}/`}>Meet the {p.name} →</a></div></article>)}</div>
<div class="route-grid"><section><span class="eyebrow">01 / Prepare</span><h3>A straightforward start</h3><p>Install the launcher, open Mods, and choose your next adventure.</p><a href={`${base}/installation/`}>Installation guide →</a></section><section><span class="eyebrow">02 / Discover</span><h3>Know your equipment</h3><p>Explore six Paladin gear families and three legendary artifacts.</p><a href={`${base}/mods/paladin-equipment/`}>Browse the armory →</a></section><section><span class="eyebrow">03 / Stay informed</span><h3>Know what is verified</h3><p>Every mod has its own version, requirements, and tested scope.</p><a href={`${base}/compatibility/`}>Check compatibility →</a></section></div>
<footer class="site-footer">An independent community project for the original For The King. Game and native game artwork belong to their respective owners. <a href={`${base}/credits/`}>Media credits & provenance</a> · <a href={`${base}/releases/`}>Release notes</a></footer>
