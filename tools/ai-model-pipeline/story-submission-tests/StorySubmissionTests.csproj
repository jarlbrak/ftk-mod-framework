<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
<PropertyGroup>
<TestManagedDir Condition="'$(TestManagedDir)' == '' and Exists('$(TestGameRoot)/FTK.app/Contents/Resources/Data/Managed/Newtonsoft.Json.dll')">$(TestGameRoot)/FTK.app/Contents/Resources/Data/Managed</TestManagedDir>
<TestManagedDir Condition="'$(TestManagedDir)' == '' and Exists('$(TestGameRoot)/FTK_Data/Managed/Newtonsoft.Json.dll')">$(TestGameRoot)/FTK_Data/Managed</TestManagedDir>
</PropertyGroup>
<Target Name="RequireShippedJson" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(TestManagedDir)/Newtonsoft.Json.dll')" Text="Pass isolated TestGameRoot or TestManagedDir with shipped Newtonsoft.Json.dll." /></Target>
<ItemGroup><Compile Include="../runtime-test/StorySubmissionPolicy.cs" Link="StorySubmissionPolicy.cs" /><Reference Include="Newtonsoft.Json"><HintPath>$(TestManagedDir)/Newtonsoft.Json.dll</HintPath></Reference></ItemGroup>
</Project>
