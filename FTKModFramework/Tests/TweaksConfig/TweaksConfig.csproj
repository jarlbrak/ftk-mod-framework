<Project Sdk="Microsoft.NET.Sdk">
  <!-- The config-backed tweak store against the real BepInEx ConfigFile. Kept apart from
       Tests/Tweaks so that project proves Core/Tweaks compiles with no BepInEx reference. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings><NoWarn>$(NoWarn);NU1701</NoWarn></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.20" />
    <Compile Include="../../Core/Tweaks/*.cs" Link="Tweaks/%(Filename)%(Extension)" />
    <Compile Include="../../Core/TweakConfigStore.cs" Link="TweakConfigStore.cs" />
  </ItemGroup>
</Project>
