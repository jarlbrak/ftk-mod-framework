---
import catalog from '../data/catalog';
const { name }=Astro.props;
const p=catalog.packages.find(p=>p.name===name)!;
const slug=p.slug;
// Utility archives can be a few hundred bytes; MiB alone would round them to 0.0.
const size=p.compressedSize>=1024*1024?`${(p.compressedSize/1024/1024).toFixed(1)} MiB`:`${(p.compressedSize/1024).toFixed(1)} KiB`;
---
<figure><img class="mod-banner" src={`${import.meta.env.BASE_URL}media/${slug}.webp`} alt={`Original ${name} promotional illustration`} width="1280" height="720"/><figcaption>Original promotional illustration. {p.category==='classes'&&'Item cards below show the published equipment artwork.'}</figcaption></figure>
<p><span class="pill">Published {p.version}</span> · By {p.author}</p>
<p>{p.description}</p>
<div class="actions"><a class="button primary" href={p.packageUrl}>Download {p.name} {p.version}</a><a class="button" href={`${import.meta.env.BASE_URL}installation/`}>Install through Mods</a></div>
<details><summary>Requirements & availability</summary>
<p>Framework <strong>{p.frameworkRange}</strong>. Published platforms: <strong>{p.platforms.join(', ')}</strong>. Dependencies: {p.dependencies.length===0?'none':JSON.stringify(p.dependencies)}.</p>
<ul>{p.requirements.map(r=><li>{r}</li>)}</ul></details>
<details><summary>Exact download identity</summary><p>Package {p.packageId} · {size}</p><p>SHA-256: <code style="overflow-wrap:anywhere">{p.sha256}</code></p><a href={p.supportUrl}>Support & feedback</a></details>
