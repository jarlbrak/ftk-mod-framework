<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>FTKReportingSteamGuard</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TestGameRoot Condition="'$(TestGameRoot)' == ''">$(MSBuildThisFileDirectory)../../../scratch/reporting-game</TestGameRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Mono.Cecil" Private="false"><HintPath>$(TestGameRoot)/BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
