<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The allocation checks measure steady-state loops. Tiered JIT can recompile a method in the
         middle of a measured loop and allocate while doing so, which made those checks flaky. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/Tweaks/*.cs" Link="Tweaks/%(Filename)%(Extension)" />
    <Compile Include="../../Core/UI/ModsPanelTweaks.cs" Link="UI/ModsPanelTweaks.cs" />
  </ItemGroup>
</Project>
