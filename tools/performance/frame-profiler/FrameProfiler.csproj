<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>FtkFrameProfiler</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <TestManagedDir Condition="Exists('$(TestGameRoot)/FTK.app/Contents/Resources/Data/Managed/Assembly-CSharp.dll')">$(TestGameRoot)/FTK.app/Contents/Resources/Data/Managed</TestManagedDir>
    <TestManagedDir Condition="Exists('$(TestGameRoot)/FTK_Data/Managed/Assembly-CSharp.dll')">$(TestGameRoot)/FTK_Data/Managed</TestManagedDir>
  </PropertyGroup>
  <Target Name="RequireIsolatedGame" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TestGameRoot)' == '' or '$(TestManagedDir)' == ''" Text="Pass TestGameRoot pointing to an isolated game copy under scratch." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="0Harmony" Private="false"><HintPath>$(TestGameRoot)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="BepInEx" Private="false"><HintPath>$(TestGameRoot)/BepInEx/core/BepInEx.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json" Private="false"><HintPath>$(TestManagedDir)/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="$(TestManagedDir)/UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
