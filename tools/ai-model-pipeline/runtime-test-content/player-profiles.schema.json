{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FTK isolated player model test profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "baseClass",
          "displayName",
          "skinset",
          "defaultSkinType",
          "renderers"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^ftkmf_modeltest_player_[a-z0-9_]{1,56}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "renderers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rendererPath",
                "glbFile"
              ],
              "properties": {
                "rendererPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "glbFile": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}\\.glb$"
                },
                "textureFile": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}\\.png$"
                    }
                  ]
                }
              }
            }
          },
          "baseClass": {
            "type": "string",
            "minLength": 1
          },
          "skinset": {
            "type": "string",
            "minLength": 1
          },
          "defaultSkinType": {
            "enum": [
              "Female",
              "Male",
              "Undead",
              "Cat",
              "Demon",
              "Fish",
              "Goblin"
            ]
          },
          "startingArmor": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,119}$"
          },
          "apparel": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rendererPath",
                "glbFile",
                "expectedNativeMeshName"
              ],
              "properties": {
                "rendererPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "glbFile": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}\\.glb$"
                },
                "textureFile": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,119}\\.png$"
                    }
                  ]
                },
                "expectedNativeMeshName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
