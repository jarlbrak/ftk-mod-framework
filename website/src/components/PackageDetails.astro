---
import catalog from '../data/catalog.json';
const { name }=Astro.props;
const p=catalog.packages.find(p=>p.name===name)!;
---
<p><span class="pill">Published {p.version}{p.name==='Thief'?' · Playtest':''}</span> · By {p.author}</p>
<p>{p.description}</p>
<div class="actions"><a class="button primary" href={p.packageUrl}>Download {p.name} {p.version}</a><a class="button" href={`${import.meta.env.BASE_URL}installation/`}>Install through Mods</a></div>
<h2>Requirements & availability</h2>
<p>Framework <strong>{p.frameworkRange}</strong>. Listed platforms: <strong>{p.platforms.join(', ')}</strong>. Dependencies: {p.dependencies.length===0?'none':JSON.stringify(p.dependencies)}.</p>
<ul>{p.requirements.map(r=><li>{r}</li>)}</ul>
<details><summary>Exact download identity</summary><p>Package {p.packageId} · {(p.compressedSize/1024/1024).toFixed(1)} MiB</p><p>SHA-256: <code style="overflow-wrap:anywhere">{p.sha256}</code></p><a href={p.supportUrl}>Support & feedback</a></details>
